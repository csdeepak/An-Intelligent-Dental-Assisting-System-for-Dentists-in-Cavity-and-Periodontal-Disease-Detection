# =============================================================================
# Dental AI Pipeline — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Virtual environments ---
venv/
env/
.env/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Dataset (large files — DO NOT commit) ---
data/processed_dataset_tufts/
data/raw/
data/*.csv
data/*.json
*.JPG
*.jpg
*.png
*.PNG
!docs/**/*.png
!docs/**/*.svg
!docs/**/*.jpg
!assets/*.png
!assets/*.svg

# --- Model checkpoints (large files) ---
models/*.pth
models/*.pt
models/*.onnx
models/*.pkl
models/checkpoints/
# YOLO detector weights are ~51 MB each (GitHub warns above 50 MB): kept on local
# disk and in _repo_archive/, never committed. See models/06_*/run_summary.txt.
models/**/*.pt

# --- Training outputs ---
# Ignored by default (these are regenerable evaluation artefacts), EXCEPT the specific runs
# whitelisted below. Added 30 Aug 2026 so a fresh clone (e.g. a teammate's machine) has every
# JSON scripts/verify_paper_numbers.py and the manuscript's cited numbers depend on, without
# a second GPU rental. All whitelisted paths are JSON/CSV/one PNG, largest 292 KB. outputs/c1_vlm/
# matters most: it is the H100 VLM run (Rs 285) and cannot be regenerated without renting a GPU
# again. See docs/results/RESULTS_LOG.md for what produced each run.
#
# MERGE NOTE (30 Aug 2026, resolving 322f787 vs f6609b7): f6609b7 replaced this whole block with
# an unconditional `!outputs/**` further down (still present a few lines below at the old
# "FILES TO KEEP" section) instead of a curated list. That re-includes literally everything ever
# written to outputs/ by any script, forever -- exactly what CLAUDE.md rule 4 ("no large binaries
# in commits") exists to prevent, since nothing then stops a future large or throwaway dump from
# being silently trackable. Kept the curated form instead and folded in every directory
# f6609b7's rule would have newly exposed, after checking each was small and a real result
# artefact (`related_work_extract.csv` is the literature-review extract behind the "49
# task-relevant papers" citation count -- worth tracking on its own merits). Left OUT:
# outputs/stage2_control_oldkdet/, whose numbers (163 images / 934 GT teeth) don't match the
# canonical 164/936 leak-free set cited everywhere else -- unclear provenance, flagged rather
# than silently included or deleted.
outputs/*
!outputs/c1_vlm/
!outputs/c1_vlm/**
!outputs/stage2_segdet/
!outputs/stage2_segdet/**
!outputs/stage2_control_olddet/
!outputs/stage2_control_olddet/**
!outputs/stage2_taxonomy/
!outputs/stage2_taxonomy/**
!outputs/c4_abstention/
!outputs/c4_abstention/**
!outputs/calibration/
!outputs/calibration/**
!outputs/lesion_loc_pipeline/
!outputs/lesion_loc_pipeline/**
!outputs/lesion_localization_segdet/
!outputs/lesion_localization_segdet/**
!outputs/lesion_localization_control_olddet/
!outputs/lesion_localization_control_olddet/**
!outputs/ningxia_external_segdet/
!outputs/ningxia_external_segdet/**
!outputs/ningxia_caries_segdet/
!outputs/ningxia_caries_segdet/**
!outputs/ningxia_caries_control_olddet/
!outputs/ningxia_caries_control_olddet/**
!outputs/ningxia_pipeline/
!outputs/ningxia_pipeline/**
!outputs/ningxia_constant-molars/
!outputs/ningxia_constant-molars/**
!outputs/bone_loss_eval/
!outputs/bone_loss_eval/**
!outputs/bootstrap_ci/
!outputs/bootstrap_ci/**
!outputs/caries_failure_panel/
!outputs/caries_failure_panel/**
!outputs/eda_tufts/
outputs/eda_tufts/*
!outputs/eda_tufts/split_v1.csv
# Deliberately NOT a blanket unignore -- that directory also holds
# split_TEMP_not_frozen_do_not_use_for_gpu_run.csv, whose own filename says not to trust it.
# split_v1.csv is the frozen detector split (transfer.md SS8); it was not tracked anywhere in
# git before this merge, only the script that regenerates it was. (A bare `!outputs/eda_tufts/`
# only permits descending into the directory -- it does not re-exclude siblings, so the
# `outputs/eda_tufts/*` re-ignore above is required before the single-file exception below it.)
!outputs/lesion_loc_all-teeth/
!outputs/lesion_loc_all-teeth/**
!outputs/lesion_loc_constant-molars/
!outputs/lesion_loc_constant-molars/**
!outputs/ningxia_external_control_olddet/
!outputs/ningxia_external_control_olddet/**
!outputs/related_work_extract.csv
runs/
logs/
wandb/

# --- Colab/Kaggle temp ---
sample_data/
.config/

# --- Compressed archives ---
*.zip
*.tar.gz
*.tar
*.rar

# =============================================================================
# FILES TO KEEP (override above patterns)
# =============================================================================
!models/.gitkeep
!models/README.md
!data/.gitkeep
!data/README.md
!outputs/.gitkeep
!outputs/README.md
# NOT `!outputs/**` -- that unconditional override was f6609b7's approach and was removed here
# during the 30 Aug merge (see the note above the outputs/* block): it silently re-includes
# every future file under outputs/, bypassing the curated whitelist entirely. The whitelist
# above the "Training outputs" heading is the single place that grants outputs/ exceptions.
!docs/architecture/*.svg
!docs/reports/*.pdf
!docs/reports/**/*.pdf

data/tufts/ZIP/Segmentation/Segmentation/teeth_polygon.json
# Built YOLO-seg training dataset (1,000 images + labels) — regenerate with
# scripts/yolo/convert_tufts_to_yolo_seg.py, never commit.
data/tufts/dataset_seg/
# Corrected R1 seg dataset (27 Aug 2026). Same reason as above: generated, ~320 MB, and
# fully reproducible from the raw data via fix_tufts_orientation.py + convert_tufts_to_yolo_seg.py.
data/tufts/dataset_seg_v2/
# Orientation-corrected radiographs (27 Aug 2026) — regenerable, ~130 MB.
data/tufts/ZIP/Radiographs_rotated_fixed/
# Raw DENTEX source annotations (re-downloadable) — the SPLIT MANIFEST built from
# them, data/dentex/splits_v2.json, IS committed and must stay tracked.
data/dentex/raw/
# Generated DENTEX crops (~26k PNGs across three variant trees). Rebuild with
# scripts/dentex/build_dentex_crops.py; the manifest + meta inside record provenance.
data/dentex/crops_v2/
# Enumeration-head training crops (~33k). Rebuild with
# scripts/dentex/build_enumeration_crops.py; the manifest inside records provenance.
data/dentex/enumeration_v1/
# The Tufts half of the enumeration-head training data (~43k crops). Rebuild with
# scripts/tufts/build_enumeration_crops.py; the manifest + meta.json inside record
# provenance, including the mirrored-numbering correction that produced the labels.
data/tufts/enumeration_v1/

# Caries cascade weights — the two BUNDLES (final_model.pth, phase2_final_bundle.pth) are
# tracked: together they are the complete runnable cascade, each carrying its own
# class_to_idx. The three below are training lineage, needed to REPRODUCE the runs but not
# to run them, so they stay on local disk with their SHA-256 recorded in
# models/07_caries_cascade/run_summary.txt — same handling as the YOLO weights. Committing
# all five would add 214 MB for 86 MB of usable model, and best_model.pth is byte-identical
# to final_model.pth anyway.
models/07_caries_cascade/best_model.pth
models/07_caries_cascade/best_phase2_final.pth
models/07_caries_cascade/best_phase2_fixed.pth

# --- Archive ignores ---
_repo_archive/datasets_workspace/Expert/
_repo_archive/datasets_workspace/Radiographs/
_repo_archive/datasets_workspace/Radiographs_rotated/
_repo_archive/datasets_workspace/Segmentation/
_repo_archive/datasets_workspace/Student/
_repo_archive/datasets_workspace/Verification Images/
_repo_archive/datasets_workspace/ZIP/
_repo_archive/datasets_workspace/dataset/
_repo_archive/datasets_workspace/opg_env/
_repo_archive/datasets_workspace/outputs/
_repo_archive/implementation_stale_clone/


# --- pytest cache (auto-generated) ---
.pytest_cache/

# Generated status page (duplicates transfer.md; regenerate on request)
worklist.html
# Ultralytics pretrained weights downloaded on demand (re-downloadable)
yolo11l-seg.pt

# v3 caries gate weights (43 MB) — summary and reports are tracked
models/09_caries_gate_v3/*.pth
data/dentex/crops_v3_phase1/

# Bone-loss crops rebuilt on 27 Aug 2026 (103 MB, 785 PNGs x3 rotation arms). Regenerable
# with scripts/tufts/rebuild_bone_loss_crops.py -- but note they are NOT faithful to the
# published bone-loss numbers: the originals came from Radiographs/Radiographs/, which is not
# on this machine, and the rebuild fails its own geometry check (RESULTS_LOG 2026-08-27u).
# Kept locally as the evidence for that finding; never commit.
data/tufts/bone_loss_crops_rebuilt/
